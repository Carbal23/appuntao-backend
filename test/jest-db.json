{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".db-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^@nestjs/schedule$": "<rootDir>/db/schedule.stub.ts"
  },
  "globalSetup": "<rootDir>/db/global-setup.ts",
  "setupFiles": ["<rootDir>/db/setup-env.ts"],
  "testTimeout": 30000
}
