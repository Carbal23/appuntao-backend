generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String         @id @default(uuid())
  email           String?        @unique
  phone           String?        @unique
  password        String?
  firstName       String
  lastName        String
  documentType    DocumentType
  documentNumber  String         @unique
  role            Role           @default(USER)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  inactivatedAt   DateTime?
  inactivatedBy   InactivationSource?
  deletionRequestedAt DateTime?
  deletionScheduledAt DateTime?
  // Datos personales eliminados. Es definitivo: la cuenta no se recupera.
  anonymizedAt        DateTime?
  businesses      Business[]     @relation("OwnerBusinesses")
  businessUsers   BusinessUser[]
  createdDebts    Debt[]         @relation("UserCreatedDebts")
  debtors         Debtor[]       @relation("UserDebtors")
  createdPayments Payment[]      @relation("UserCreatedPayments")
  refreshTokens   RefreshToken[]
  authLogs        AuthLog[]
  consents        UserConsent[]
  invitationsCreated  Invitation[] @relation("InvitationsCreated")
  invitationsAccepted Invitation[] @relation("InvitationsAccepted")
  transfersSent     BusinessOwnershipTransfer[] @relation("TransfersSent")
  transfersReceived BusinessOwnershipTransfer[] @relation("TransfersReceived")
}

model Business {
  id            String         @id @default(uuid())
  ownerId       String
  name          String
  address       String?
  currency      String         @default("COP")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inactivatedAt DateTime?
  owner         User           @relation("OwnerBusinesses", fields: [ownerId], references: [id])
  businessUsers BusinessUser[]
  debts         Debt[]
  debtors       Debtor[]
  payments      Payment[]
  invitations   Invitation[]   @relation("BusinessInvitations")
  paymentGroups PaymentGroup[]
  ownershipTransfers BusinessOwnershipTransfer[]
}

model BusinessUser {
  id         String           @id @default(uuid())
  businessId String
  userId     String
  role       BusinessUserRole @default(VIEWER)
  createdAt  DateTime         @default(now())
  business   Business         @relation(fields: [businessId], references: [id])
  user       User             @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
}

model Debtor {
  id             String         @id @default(uuid())
  businessId     String
  userId         String?
  name           String
  phone          String?
  documentType   DocumentType?
  documentNumber String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  inactivatedAt  DateTime?
  debts          Debt[]
  business       Business       @relation(fields: [businessId], references: [id])
  user           User?          @relation("UserDebtors", fields: [userId], references: [id])
  invitations    Invitation[]
  paymentGroups  PaymentGroup[]

  @@index([businessId, phone])
  @@index([businessId, documentNumber])
}

model Debt {
  id            String     @id @default(uuid())
  businessId    String
  debtorId      String
  amount        Decimal    @db.Decimal(12, 2)
  balance       Decimal    @db.Decimal(12, 2)
  currency      String     @default("COP")
  description   String?
  status        DebtStatus @default(OPEN)
  dueDate       DateTime?
  createdBy     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  business      Business   @relation(fields: [businessId], references: [id])
  createdByUser User       @relation("UserCreatedDebts", fields: [createdBy], references: [id])
  debtor        Debtor     @relation(fields: [debtorId], references: [id])
  payments      Payment[]

  @@index([businessId, debtorId])
}

model Payment {
  id             String        @id @default(uuid())
  debtId         String
  businessId     String
  paymentGroupId String?

  amount         Decimal       @db.Decimal(12, 2)
  paymentDate    DateTime      @default(now())
  method         PaymentMethod @default(CASH)
  type           PaymentType   @default(PAYMENT)
  note           String?
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  createdByUser  User          @relation("UserCreatedPayments", fields: [createdBy], references: [id])
  debt           Debt          @relation(fields: [debtId], references: [id])
  business       Business      @relation(fields: [businessId], references: [id])
  paymentGroup   PaymentGroup? @relation(fields: [paymentGroupId], references: [id])

  @@index([businessId])
  @@index([debtId, businessId])
  @@index([paymentGroupId])
}

model PaymentGroup {
  id          String   @id @default(uuid())
  businessId  String
  debtorId    String
  totalAmount Decimal  @db.Decimal(12, 2)
  createdBy   String
  createdAt   DateTime @default(now())
  reversedAt  DateTime?

  business Business  @relation(fields: [businessId], references: [id])
  debtor   Debtor    @relation(fields: [debtorId], references: [id])
  payments Payment[]

  @@index([businessId])
  @@index([debtorId])
  @@index([reversedAt])
}

// Invitación de un negocio a una persona, dirigida a su correo o teléfono:
// como empleado (BUSINESS_USER) o para vincularla con su registro de cliente
// (DEBTOR). Le aparece en la app a quien tenga ese correo o teléfono, y solo
// esa persona puede aceptarla. El código sirve para compartirla por fuera.
model Invitation {
  id           String            @id @default(uuid())
  businessId   String
  debtorId     String?
  email        String?
  phone        String?
  code         String            @unique
  expiresAt    DateTime
  status       InvitationStatus  @default(PENDING)
  type         InvitationType    @default(DEBTOR)
  role         BusinessUserRole?
  createdById  String?
  acceptedById String?
  respondedAt  DateTime?
  createdAt    DateTime          @default(now())
  business     Business          @relation("BusinessInvitations", fields: [businessId], references: [id])
  debtor       Debtor?           @relation(fields: [debtorId], references: [id])
  createdBy    User?             @relation("InvitationsCreated", fields: [createdById], references: [id])
  acceptedBy   User?             @relation("InvitationsAccepted", fields: [acceptedById], references: [id])

  @@index([businessId, status])
  @@index([email, status])
  @@index([phone, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  familyId   String 
  tokenHash  String    @unique
  expiresAt  DateTime
  rotatedAt  DateTime? 
  createdAt  DateTime  @default(now())
  deviceId   String? 
  deviceName String? 
  deviceInfo String? 
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@index([userId, deviceId])
}

model AuthLog {
  id         String       @id @default(uuid())
  userId     String? 
  event      AuthLogEvent
  identifier String?
  reason     String? 
  ipAddress  String?
  userAgent  String?
  deviceId   String?
  deviceName String?
  deviceInfo String? 
  createdAt  DateTime     @default(now())
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

enum AuthLogEvent {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_BLOCKED
  LOGOUT
  LOGOUT_ALL_DEVICES
  PASSWORD_CHANGED
  PASSWORD_CHANGE_FAILED
  REFRESH_TOKEN_REUSED
  ACCOUNT_DEACTIVATED
  ACCOUNT_REACTIVATED
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETION_CANCELLED
  ACCOUNT_ANONYMIZED
}

enum InactivationSource {
  SELF
  ADMIN
}

model LegalDocument {
  id          String            @id @default(uuid())
  type        LegalDocumentType
  version     String
  content     String 
  contentHash String // SHA-256 del texto: prueba de qué se aceptó exactamente
  url         String? // página pública donde también está publicado
  publishedAt DateTime
  createdAt   DateTime          @default(now())
  consents    UserConsent[]

  @@unique([type, version])
  @@index([type, publishedAt])
}

model UserConsent {
  id         String        @id @default(uuid())
  userId     String
  documentId String
  acceptedAt DateTime      @default(now())
  ipAddress  String?
  userAgent  String?
  revokedAt  DateTime? // el usuario retiró la autorización (eliminó su cuenta)
  user       User          @relation(fields: [userId], references: [id])
  document   LegalDocument @relation(fields: [documentId], references: [id])

  @@unique([userId, documentId])
  @@index([userId])
}

enum LegalDocumentType {
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
}

// Propuesta del dueño de un negocio para pasarle la propiedad a un miembro.
// El miembro debe aceptarla: ser dueño implica responder por el negocio y por
// los datos de sus clientes. Solo puede haber una pendiente por negocio.
model BusinessOwnershipTransfer {
  id          String                  @id @default(uuid())
  businessId  String
  fromUserId  String
  toUserId    String
  status      OwnershipTransferStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime                @default(now())
  business    Business                @relation(fields: [businessId], references: [id])
  fromUser    User                    @relation("TransfersSent", fields: [fromUserId], references: [id])
  toUser      User                    @relation("TransfersReceived", fields: [toUserId], references: [id])

  @@index([businessId, status])
  @@index([toUserId, status])
}

enum OwnershipTransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum DocumentType {
  CC
  NIT
  FOREIGNER
}

enum Role {
  USER // por defecto, cualquier usuario registrado
  ADMIN // administrador de la plataforma (soporte, backoffice)
}

enum BusinessUserRole {
  OWNER // dueño del negocio (aunque también está en Business.ownerId)
  ADMIN // puede gestionar usuarios, deudas, pagos
  CASHIER // puede registrar pagos, ver deudas
  VIEWER // solo lectura
}

enum DebtStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  OTHER
}

enum PaymentType {
  PAYMENT
  ADJUSTMENT
  REVERSAL
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum InvitationType {
  DEBTOR
  BUSINESS_USER
}
